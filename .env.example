# LoveTap 환경변수 — .env.local에 복사해서 실제 값을 입력하세요.
# 이 파일 자체에는 실제 키를 넣지 마세요.

# Supabase (무료 티어) — 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# anon 키는 이제 브라우저에서 테이블 접근에 쓸 수 없습니다(RLS가 anon을 전면 차단).
# 남겨 두어도 앱 동작에는 쓰이지 않습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ⚠️ 서버 전용 — Route Handler(/api/quizzes/...)만 사용합니다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에서 읽지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 사이트 공개 URL (OG 메타·공유 링크 기준 주소) — Vercel 배포 도메인으로 교체
NEXT_PUBLIC_SITE_URL=https://lovetap-psi.vercel.app
